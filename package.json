{
  "name": "@floatingsk/dsh-vision",
  "version": "0.1.6",
  "description": "为 DeepSeek Harness（dsh 插件）与 Claude Code（MCP）提供图片理解能力：本地 OCR（macOS Vision / Windows 内置 OCR）+ 云端 VLM（多供应商，OpenAI 兼容）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "mcp",
    "clipboard",
    "bin/vision-ocr.swift",
    "bin/vision-ocr.ps1",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "build:ocr": "swiftc -Xcc -fmodules-cache-path=\"$PWD/.cache\" -O bin/vision-ocr.swift -o bin/vision-ocr"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "vision",
    "vlm",
    "ocr",
    "image"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  }
}